# Copie este arquivo para ".env" e ajuste. Sem .env, a plataforma roda em modo local de desenvolvimento.

# 1 = modo desenvolvimento (mensagens de erro detalhadas). Use 0 quando outras pessoas forem acessar.
SIRG_DEBUG=0

# Endereços pelos quais a plataforma será acessada (separados por vírgula)
SIRG_ALLOWED_HOSTS=localhost,127.0.0.1,200.17.146.126
# Necessário quando acessada por outro endereço (inclua a porta)
SIRG_CSRF_TRUSTED_ORIGINS=http://200.17.146.126:8001

# Endereço que os colegas usam (aparece na mensagem de senha provisória)
SIRG_URL_BASE=http://200.17.146.126:8001

# Porta do servidor de rede (o SiMED usa a 8000)
SIRG_PORTA=8001

# Redes que podem acessar (vazio = qualquer uma). Ex.: 200.17.0.0/16,10.0.0.0/8
SIRG_REDES_PERMITIDAS=

# Proteção do login: tentativas erradas seguidas antes do bloqueio e minutos de bloqueio
SIRG_MAX_TENTATIVAS=5
SIRG_BLOQUEIO_MINUTOS=15

# Backup: pasta de destino (de preferência em outro disco ou pasta de rede) e quantos manter
# SIRG_BACKUP_DIR=\\servidor\pasta\backup-sirg
SIRG_BACKUP_MANTER=30

# Banco de dados: sqlite (padrão) ou postgres (ex.: na AWS)
SIRG_DB=sqlite
# SIRG_DB_NOME=sirg
# SIRG_DB_USUARIO=sirg
# SIRG_DB_SENHA=
# SIRG_DB_HOST=localhost
# SIRG_DB_PORTA=5432

# 1 quando estiver atrás de HTTPS (ex.: acesso pelo domínio via Cloudflare Tunnel).
# Atenção: com 1, o login só funciona pelo endereço https (o http://IP:8001 da rede interna deixa de entrar).
SIRG_HTTPS=0

# 1 quando o acesso pela internet vier de um Cloudflare Tunnel (cloudflared) instalado NESTE computador,
# apontando para http://127.0.0.1:8001. Faz a auditoria registrar o IP real de quem acessa.
SIRG_TUNEL=0


# Ambiente: prd (produção) ou hml (homologação: faixa laranja no alto e cookies separados).
# O instalar_hml.bat cria o .env da homologação sozinho (porta 8003, tarefa "SiRG - HML").
SIRG_AMBIENTE=prd
# Nome da tarefa agendada que mantém este servidor no ar
SIRG_TAREFA=SiRG - Servidor

# A quem pedir ajuda (aparece na tela de entrada). Ex.: DGDI · dgdi@cefetmg.br · (31) 3319-0000
# SIRG_CONTATO=
